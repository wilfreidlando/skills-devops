# Carnet DevOps — environnement « prod » sur le VPS.
# Copier en .env dans /app/skills-devops/prod, puis remplacer chaque CHANGE_ME
# (README, étape 3). Jamais committé.

# ── Plateforme ──
DEPLOYMENT=prod
ENV_FILE=.env
APP_PUBLIC_HOST=skills-devops.visibilitycam.com
LETSENCRYPT_EMAIL=messagerie@visibilitycam.com

# ── Laravel ──
APP_NAME="Carnet DevOps"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://skills-devops.visibilitycam.com
APP_LOCALE=fr

LOG_CHANNEL=stderr
# Journaux en JSON : Alloy lit « level_name » et en fait l'étiquette « level » dans Grafana
# (panneaux Erreurs et Avertissements). Sans cette ligne, le niveau n'apparaît pas.
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=skills-devops-db
DB_PORT=5432
DB_DATABASE=skills_devops
DB_USERNAME=skills_devops
DB_PASSWORD=CHANGE_ME

REDIS_CLIENT=phpredis
REDIS_HOST=skills-devops-redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# ── Sauvegardes (guide 4 de la plateforme) ──
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_TIME=03:15
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
