# Comment /app/vps-platform/bin/deploy.sh déploie ce projet (aucun secret ici).
# Projets Docker : skills-devops-staging et skills-devops-prod.
APP_NAME=skills-devops
COMPOSE_FILE=compose.prod.yaml
ENV_FILE_PROD=.env
ENV_FILE_STAGING=.env.staging
STAGING_BRANCH=main

# Santé : /up répond 200 quand Laravel démarre.
HEALTH_SERVICE=skills-devops-web
HEALTH_CMD="wget -qO- http://127.0.0.1:8000/up >/dev/null"
HEALTH_TIMEOUT=120

# Migrations avant la bascule, avec la nouvelle image.
MIGRATE_SERVICE=skills-devops-web
MIGRATE_CMD="php artisan migrate --force"

# Sauvegarde chiffrée avant chaque mise en production.
BACKUP_SERVICE=backup
DB_SERVICE=skills-devops-db
